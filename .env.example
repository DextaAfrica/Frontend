# Public URL used for metadata and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional managed-content endpoint. GET {CONTENT_API_URL}/home must return the
# homepage contract in src/features/home/types/home-page.ts. Local typed content
# is used automatically when this is unset or unavailable.
CONTENT_API_URL=
CONTENT_API_TOKEN=
# Bearer secret accepted by POST /api/revalidate for CMS publish webhooks.
CONTENT_REVALIDATION_SECRET=

# Server-only newsletter delivery webhook. Receives validated JSON subscriptions.
NEWSLETTER_WEBHOOK_URL=
# Optional bearer token sent to the webhook. Never prefix this variable with NEXT_PUBLIC_.
NEWSLETTER_WEBHOOK_TOKEN=

# Server-only contact delivery webhook. Receives validated JSON enquiries.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent to the contact webhook.
CONTACT_WEBHOOK_TOKEN=
